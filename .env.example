# KnowledgeOps Environment Configuration Example

# LLM Provider Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Embeddings Configuration
EMBEDDING_PROVIDER=mock  # Options: mock, sentence-transformers, fastembed

# Vector Database (Qdrant) Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledgeops_chunks

# Observability & System
LOG_LEVEL=INFO
APP_ENV=development
